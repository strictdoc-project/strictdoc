#
# The apply-changes command applies a changes file of the static editor. A
# dry run reports the result without writing the document. Applying the same
# file a second time changes nothing.
#
# @relation(SDOC-SRS-216, scope=file)
#

RUN: mkdir -p %T/input
RUN: cp %S/input/input.sdoc %T/input/input.sdoc

RUN: %strictdoc apply-changes %T/input %S/changes.json --dry-run | filecheck %s --check-prefix CHECK-DRY
CHECK-DRY: REQ-1 (input/input.sdoc): applied
CHECK-DRY:   Changed fields: STATEMENT, COMMENT.
CHECK-DRY: MID 7d3e4a6f0b2c4e5d9a8b1c2d3e4f5a6b (input/input.sdoc): applied
CHECK-DRY:   Changed fields: TITLE.
CHECK-DRY: Would apply 2 change(s) to 1 document(s). Already applied: 0. Conflicts: 0. Errors: 0.
CHECK-DRY: Dry run: no files were written.
RUN: %diff %S/input/input.sdoc %T/input/input.sdoc

RUN: %strictdoc apply-changes %T/input %S/changes.json | filecheck %s --check-prefix CHECK-APPLY
CHECK-APPLY: Applied 2 change(s) to 1 document(s). Already applied: 0. Conflicts: 0. Errors: 0.
RUN: %diff %S/expected.sdoc %T/input/input.sdoc

RUN: %strictdoc apply-changes %T/input %S/changes.json | filecheck %s --check-prefix CHECK-AGAIN
CHECK-AGAIN: REQ-1 (input/input.sdoc): already applied
CHECK-AGAIN: Applied 0 change(s) to 0 document(s). Already applied: 2. Conflicts: 0. Errors: 0.
RUN: %diff %S/expected.sdoc %T/input/input.sdoc
