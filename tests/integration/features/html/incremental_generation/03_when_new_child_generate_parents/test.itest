#
# @relation(SDOC-SRS-2, scope=file)
#

# Create a separate input folder to ensure clear management of the SDoc files.
RUN: %mkdir %S/sandbox
RUN: %cp %S/parent.sdoc %S/sandbox/

RUN: %strictdoc --debug export %S/sandbox --output-dir %T --no-parallelization | filecheck %s --dump-input=fail --check-prefix=CHECK-FIRST
CHECK-FIRST: Export to HTML: Parent doc

RUN: %strictdoc --debug export %S/sandbox --output-dir %T --no-parallelization | filecheck %s --dump-input=fail --check-prefix=CHECK-SECOND
CHECK-SECOND: Skip: Parent doc

RUN: %cp %S/child.sdoc %S/sandbox/child.sdoc
RUN: %strictdoc --debug export %S/sandbox --output-dir %T --no-parallelization | filecheck %s --dump-input=fail --check-prefix=CHECK-THIRD
CHECK-THIRD: Export to HTML: Child doc
CHECK-THIRD: Export to HTML: Parent doc

RUN: %cp %S/grandchild.sdoc %S/sandbox/grandchild.sdoc
RUN: %strictdoc --debug export %S/sandbox --output-dir %T --no-parallelization | filecheck %s --dump-input=fail --check-prefix=CHECK-FOURTH
CHECK-FOURTH: Skip: Parent doc
CHECK-FOURTH: Export to HTML: Child doc
CHECK-FOURTH: Export to HTML: Grandchild doc

RUN: rm %S/sandbox/grandchild.sdoc
RUN: %strictdoc --debug export %S/sandbox --output-dir %T --no-parallelization | filecheck %s --dump-input=fail --check-prefix=CHECK-FIFTH
CHECK-FIFTH: Skip: Parent doc
CHECK-FIFTH: Export to HTML: Child doc

RUN: rm %S/sandbox/child.sdoc
RUN: %strictdoc --debug export %S/sandbox --output-dir %T --no-parallelization | filecheck %s --dump-input=fail --check-prefix=CHECK-SIXTH
CHECK-SIXTH: Export to HTML: Parent doc
