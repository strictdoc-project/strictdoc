#
# When ProjectConfig.custom_node_uid_function is set, manage auto-uid shall
# use the UID it returns (composed from prefix and next_number) instead of
# the default f"{prefix}{next_number}".
#

RUN: cp %S/input.sdoc %T/
RUN: cp %S/strictdoc_config.py %T/
RUN: %strictdoc manage auto-uid %T/
RUN: %diff %S/input.expected.sdoc %T/input.sdoc
