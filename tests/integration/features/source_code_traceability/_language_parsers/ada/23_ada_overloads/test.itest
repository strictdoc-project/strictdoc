# @relation(SDOC-SRS-208, SDOC-SRS-137, scope=file)

RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/_source_files/pkg.ads.html"
RUN: %check_exists --file --invert "%T/html/_source_files/pkg.adb.html"

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML
CHECK-HTML: <a{{.*}}href="../_source_files/pkg.ads.html#REQ-1#2#3">
CHECK-HTML: pkg.ads, <i>lines: 2-3</i>, function Pkg.Bar
CHECK-HTML: <a{{.*}}href="../_source_files/pkg.ads.html#REQ-2#5#6">
CHECK-HTML: pkg.ads, <i>lines: 5-6</i>, function Pkg.Bar

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-NO-BODY
CHECK-NO-BODY-NOT: pkg.adb.html
