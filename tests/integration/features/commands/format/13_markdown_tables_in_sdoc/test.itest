# @relation(SDOC-SRS-213, scope=file)

#
# Verify that the format command aligns the misaligned Markdown pipe tables of
# an SDoc document with Markdown markup as the Format table button of the Web
# UI does. The extra cells of a row with more cells than the header become
# columns. An aligned table and a table in a fenced code block stay as they
# are. A second format pass must produce identical output (idempotency).
#

RUN: mkdir -p %T/pass1
RUN: cp %S/input.sdoc %T/pass1/input.sdoc
RUN: cp %S/strictdoc_config.py %T/pass1/strictdoc_config.py

RUN: %strictdoc format %T/pass1/
RUN: %diff %S/input_expected.sdoc %T/pass1/input.sdoc

RUN: cp -r %T/pass1 %T/pass2
RUN: %strictdoc format %T/pass2/
RUN: %diff %T/pass1/input.sdoc %T/pass2/input.sdoc
