#
# Verify MD-36: a document with YAML front matter and an H1 metadata block.
#
# The HTML export shows the fields of both places as document metadata. A format
# pass writes the reserved fields to the H1 metadata block, the reserved field
# UID from the front matter included. The reserved fields go first. Each custom
# field stays in the place it was read from.
#

RUN: %strictdoc export %S/input --formats=html --output-dir %T/html_export | filecheck %s --dump-input=fail --check-prefix CHECK-EXPORT
CHECK-EXPORT: Export completed.

RUN: %cat %T/html_export/html/input/input.md.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML
CHECK-HTML: EXAMPLE-GUIDE
CHECK-HTML: 1.10
CHECK-HTML: name:
CHECK-HTML: example-writing-guide
CHECK-HTML: Author:
CHECK-HTML: Documentation team

RUN: mkdir -p %T/format
RUN: cp %S/input/input.md %T/format/input.md
RUN: %strictdoc format %T/format/
RUN: diff %S/expected_output/input.md %T/format/input.md

RUN: %strictdoc format %T/format/
RUN: diff %S/expected_output/input.md %T/format/input.md
