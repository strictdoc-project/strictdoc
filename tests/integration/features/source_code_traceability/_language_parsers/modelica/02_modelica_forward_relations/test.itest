CHECK-HTML: href="../_source_files/Rig.mo.html#REQ-1#4#4"
CHECK-HTML: function Rig.Check.req1Check()
CHECK-HTML: href="../_source_files/Rig.mo.html#REQ-2#10#10"
CHECK-HTML: class Rig.Temperature
