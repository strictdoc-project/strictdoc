#
# @relation(SDOC-SRS-109, scope=file)
#

RUN: %strictdoc export %S --included-documents --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/20_included_documents_in_nested_folders/_assets/file.svg"
RUN: %check_exists --file "%T/html/20_included_documents_in_nested_folders/nested/_assets/file.svg"
RUN: %check_exists --file "%T/html/20_included_documents_in_nested_folders/nested/subnested/_assets/file.svg"

RUN: %cat %T/html/20_included_documents_in_nested_folders/input.sdoc.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML

CHECK-HTML:data-level="0"
CHECK-HTML:href="../20_included_documents_in_nested_folders/input.sdoc.html"
CHECK-HTML:href="../20_included_documents_in_nested_folders/nested/nested.sdoc.html"
CHECK-HTML:href="../20_included_documents_in_nested_folders/nested/subnested/subnested.sdoc.html"

CHECK-HTML:data-level="1"
CHECK-HTML:data-level="1.1"
CHECK-HTML:data-level="1.1.1"
CHECK-HTML:data-level="1.1.1.1"
CHECK-HTML:data-level="1.1.1.1.1"

RUN: %cat %T/html/20_included_documents_in_nested_folders/nested/nested.sdoc.html | filecheck %s --dump-input=fail --check-prefix CHECK-NESTED-HTML

CHECK-NESTED-HTML:href="../../20_included_documents_in_nested_folders/input.sdoc.html"
CHECK-NESTED-HTML:href="../../20_included_documents_in_nested_folders/nested/nested.sdoc.html"
CHECK-NESTED-HTML:href="../../20_included_documents_in_nested_folders/nested/subnested/subnested.sdoc.html"

RUN: %cat %T/html/20_included_documents_in_nested_folders/nested/subnested/subnested.sdoc.html | filecheck %s --dump-input=fail --check-prefix CHECK-SUBNESTED-HTML

CHECK-SUBNESTED-HTML:href="../../../20_included_documents_in_nested_folders/input.sdoc.html"
CHECK-SUBNESTED-HTML:href="../../../20_included_documents_in_nested_folders/nested/nested.sdoc.html"
CHECK-SUBNESTED-HTML:href="../../../20_included_documents_in_nested_folders/nested/subnested/subnested.sdoc.html"

