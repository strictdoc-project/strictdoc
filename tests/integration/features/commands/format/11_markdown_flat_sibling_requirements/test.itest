REQUIRES: PLATFORM_IS_NOT_WINDOWS

#
# Verify SDOC-MD-35: a SECTION heading whose body holds titleless flat
# sibling requirement records (no subheading of their own) round-trips
# through `strictdoc format` without losing any of the records.
# A second format pass must produce identical output (idempotency).
#

RUN: mkdir -p %T/pass1
RUN: cp %S/input.md %T/pass1/input.md
RUN: cp %S/strictdoc_config.py %T/pass1/strictdoc_config.py

RUN: %strictdoc format %T/pass1/

RUN: %cat %T/pass1/input.md | filecheck %s --dump-input=fail

# The SECTION heading keeps its explicit Type marker.
CHECK: ## Assembly
CHECK-NEXT: {{^$}}
CHECK-NEXT: **Type**: SECTION

# Every flat sibling record survives, each with its own Type marker.
CHECK: **Type**: REQUIREMENT \
CHECK-NEXT: **UID**: REQ-010

CHECK: **Type**: REQUIREMENT \
CHECK-NEXT: **UID**: REQ-030

CHECK: **Type**: REQUIREMENT \
CHECK-NEXT: **UID**: REQ-040

# Second pass must produce identical output (idempotency).
RUN: cp -r %T/pass1 %T/pass2
RUN: %strictdoc format %T/pass2/
RUN: diff %T/pass1/input.md %T/pass2/input.md
