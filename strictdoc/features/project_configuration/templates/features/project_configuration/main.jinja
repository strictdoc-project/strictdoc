<div class="main" data-testid="project-configuration-page">
  <div class="dashboard">
    <div class="dashboard-main">
      <div class="dashboard-block">
        <div class="dashboard-block-title">Project configuration</div>
          <div class="sdoc-table_key_value imbedded">

          <div class="sdoc-table_key_value-subgrid" data-testid="project-configuration-main-values">
            {% for key_value_pair in [
              {"Key": "Configuration file", "Value": view_object.active_configuration_path()},
              {"Key": "Project title", "Value": view_object.project_config.project_title},
              {"Key": "Server host", "Value": view_object.project_config.server_host},
              {"Key": "Server port", "Value": view_object.project_config.server_port},
            ] %}
              {% include "components/table_key_value/index.jinja" %}
            {% endfor %}
          </div>

          <div class="sdoc-table_key_value-subgrid" data-testid="project-configuration-features-values">
            {% for key_value_pair in [
              {"Section": "Features"},
              {"Key": "Project features", "Value": view_object.project_features_display()},
            ] %}
              {% include "components/table_key_value/index.jinja" %}
            {% endfor %}
          </div>

          <div class="sdoc-table_key_value-subgrid" data-testid="project-configuration-additional-values">
            {% for key_value_pair in [
              {"Section": "Configuration"},
              {"Key": "Lazy document loading threshold", "Value": view_object.project_config.lazy_document_loading_threshold},
              {"Append": view_object.default_lazy_document_loading_threshold() ~ " by default."},
              {"Key": "Output directory", "Value": view_object.project_config.output_dir},
              {"Key": "Grammar aliases", "Value": view_object.project_config.grammars},
              {"Key": "Custom CSS path", "Value": view_object.display_or_none(view_object.project_config.custom_css_path)},
              {"Key": "Favicon path", "Value": view_object.display_or_none(view_object.project_config.favicon_path)},
            ] %}
              {% include "components/table_key_value/index.jinja" %}
            {% endfor %}
          </div>{# // .sdoc-table_key_value #}

        </div>

      </div>{# // .dashboard-block #}
    </div>{# // .dashboard-main #}

    <div class="dashboard-aside" data-testid="project-tree-configuration">
      <div class="dashboard-block">
        {# <div class="dashboard-block-title"></div> #}

        {% if view_object.project_config.input_paths|length %}
          <b>Input paths:</b>
          {% for path_ in view_object.project_config.input_paths %}
            {% set external_, internal_ = view_object.split_path_for_display(path_) %}
            <code class="dashboard-path" data-js-path-reveal data-testid="project-configuration-input-path">
              {%- if external_ -%}
                <span class="dashboard-path-external" data-js-path-reveal-control data-testid="project-configuration-input-path-external" aria-expanded="false" role="button" tabindex="0" title="Click to reveal">…</span><span class="dashboard-path-external-full">{{ external_ }}</span>
              {%- endif -%}
              <span class="dashboard-path-internal">{{ internal_ }}</span>
            </code><br/>
          {% endfor %}
        {% endif %}

        {% set exclude_doc_paths_configured = view_object.project_config.exclude_doc_paths | reject("in", view_object.project_config.exclude_paths_from_gitignore) | list %}
        {% set exclude_doc_paths_gitignore = view_object.project_config.exclude_doc_paths | select("in", view_object.project_config.exclude_paths_from_gitignore) | list %}
        {% if view_object.project_config.include_doc_paths|length or exclude_doc_paths_configured|length %}
          <p>Document paths:</p>
          <ul>
            {% for path_ in view_object.project_config.include_doc_paths %}
              <li style="list-style-type: '✔️    '">{{ path_ }}</li>
            {% endfor %}
            {% for path_ in exclude_doc_paths_configured %}
              <li style="list-style-type: '⛔    '">{{ path_ }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if exclude_doc_paths_gitignore|length %}
          <details class="dashboard-excluded-via-gitignore">
            <summary>⛔ Excluded via .gitignore ({{ exclude_doc_paths_gitignore|length }})</summary>
            <ul>
              {% for path_ in exclude_doc_paths_gitignore %}
                <li style="list-style-type: '⛔    '">{{ path_ }}</li>
              {% endfor %}
            </ul>
          </details>
        {% endif %}


      </div>
      <div class="dashboard-block">
        {# <div class="dashboard-block-title"></div> #}

        {% if view_object.project_config.source_root_path is not none %}
          {% set external_, internal_ = view_object.split_path_for_display(view_object.project_config.source_root_path) %}
          <b>Source root path:</b>
          <code class="dashboard-path" data-js-path-reveal data-testid="project-configuration-source-root-path">
            {%- if external_ -%}
              <span class="dashboard-path-external" data-js-path-reveal-control data-testid="project-configuration-source-root-path-external" aria-expanded="false" role="button" tabindex="0" title="Click to reveal">…</span><span class="dashboard-path-external-full">{{ external_ }}</span>
            {%- endif -%}
            <span class="dashboard-path-internal">{{ internal_ }}</span>
          </code>
        {% endif %}

        {% set exclude_source_paths_configured = view_object.project_config.exclude_source_paths | reject("in", view_object.project_config.exclude_paths_from_gitignore) | list %}
        {% set exclude_source_paths_gitignore = view_object.project_config.exclude_source_paths | select("in", view_object.project_config.exclude_paths_from_gitignore) | list %}
        {% if view_object.project_config.include_source_paths|length or exclude_source_paths_configured|length %}
          <p>Source paths:</p>
          <ul>
            {% for path_ in view_object.project_config.include_source_paths %}
              <li style="list-style-type: '✔️    '">{{ path_ }}</li>
            {% endfor %}
            {% for path_ in exclude_source_paths_configured %}
              <li style="list-style-type: '⛔    '">{{ path_ }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if exclude_source_paths_gitignore|length %}
          <details class="dashboard-excluded-via-gitignore">
            <summary>⛔ Excluded via .gitignore ({{ exclude_source_paths_gitignore|length }})</summary>
            <ul>
              {% for path_ in exclude_source_paths_gitignore %}
                <li style="list-style-type: '⛔    '">{{ path_ }}</li>
              {% endfor %}
            </ul>
          </details>
        {% endif %}
      </div>
    </div>
  </div>
</div>
