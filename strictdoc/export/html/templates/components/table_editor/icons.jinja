{#- Icons of the table editor's menus; table_editor.js clones them. -#}
<template id="template-table-editor-icons">
  <span js-table_editor-icon="insert-above">{%- include "icons/ico16_arrow_up.svg" -%}</span>
  <span js-table_editor-icon="insert-below">{%- include "icons/ico16_arrow_down.svg" -%}</span>
  <span js-table_editor-icon="insert-left">{%- include "icons/ico16_arrow_left.svg" -%}</span>
  <span js-table_editor-icon="insert-right">{%- include "icons/ico16_arrow_right.svg" -%}</span>
  <span js-table_editor-icon="delete">{%- include "icons/ico16_delete.svg" -%}</span>
  <span js-table_editor-icon="table">{%- include "icons/ico16_table.svg" -%}</span>
</template>
