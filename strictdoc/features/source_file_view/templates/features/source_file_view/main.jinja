<div class="main">
{# todo: update this template #}
<div id="sourceContainer" class="source-file__source">

  {% include "features/source_file_view/file_stats.jinja" %}

  {%- if view_object.source_lines|length > 0 -%}
  <div id="source" class="source">
    {#-- SourceLine records come from create_source_lines() in Python. --#}
    {%- for line in view_object.source_lines -%}
      {%- if line.range_opener is not none -%}
        {%- set opener = line.range_opener -%}
        {%- set current_marker_link = view_object.render_marker_range_link(opener) -%}
        {%- set current_range_begin = opener.ng_range_line_begin -%}
        {%- set current_range_end = opener.ng_range_line_end -%}
        <div
          class="source__range collapsed"
          data-begin="{{ current_range_begin }}"
          data-end="{{ current_range_end }}"
        >
          <div class="source__range-header">{# used by scroll to #}

            {%- with
              begin=current_range_begin,
              end=current_range_end,
              href=current_marker_link,
              scope=opener.markers[0].get_description()
            -%}
              {% include "features/source_file_view/range_button.jinja" %}
            {%- endwith -%}

          </div>
          <div class="source__range-cell">
            <div
              class="source__range-handler"
              data-begin="{{ current_range_begin }}"
              data-end="{{ current_range_end }}"
            >{% include "icons/ico16_section_collapse.svg" %}</div>
          </div>
          <div class="source__range-cell">
            <ul class="source__range-titles-list">
              {%- for marker_ in opener.markers -%}
                {%- for req in marker_.reqs_objs -%}
                <li>
                  {{ view_object.render_node_title_for_banner_header(marker_, req.uid) }}
                </li>
                {%- endfor -%}
              {%- endfor -%}
            </ul>
            <div class="source__range-banner source__range-start">
              {%- for marker_ in opener.markers -%}
                {%- for req in marker_.reqs_objs -%}
                  {{ view_object.render_detailed_node_for_banner(req.uid) }}
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      {% endif %}

      <div data-line="{{ line.number }}" class="source__line">
        <div data-line="{{ line.number }}" id="line-{{ line.number }}" class="source__line-number"><pre>{{ line.number }}</pre></div>
        <div data-line="{{ line.number }}" class="source__line-content">
          {%- if not line.is_empty -%}
            {# Note: Cannot format HTML/Jinja blocks within 'pre' tags! #}
            <pre class="highlight">{{ line.content }}</pre>
          {%- else -%}
            <pre data-state="empty" style="user-select: none">&nbsp;</pre>
          {%- endif -%}
        </div>
      </div>

      {%- if line.range_closer is not none %}
        {%- set closer_marker = line.range_closer.markers[0] %}
        <div
          class="source__range-closer"
          data-end="{{ closer_marker.ng_range_line_end }}"
        >
          <div class="source__range-closer-label">
            {%- with
              begin=closer_marker.ng_range_line_begin,
              end=closer_marker.ng_range_line_end,
              href=view_object.render_marker_range_link(line.range_closer),
              scope=closer_marker.get_description()
            -%}
              {% include "features/source_file_view/range_button.jinja" %}
            {%- endwith -%}
          </div>
        </div>
      {% endif %}
    {%- endfor -%}
  </div>
  {%- else -%}
  <div style="text-align: center">
    Source file is empty.
  </div>
  {%- endif -%}
</div>
</div>{# /.main #}
