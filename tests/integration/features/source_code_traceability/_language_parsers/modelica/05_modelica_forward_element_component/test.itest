# @relation(SDOC-LLR-224, scope=file)

RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --check-prefix CHECK-HTML
CHECK-HTML: href="../_source_files/Rig.mo.html#TC-1#3#9"
CHECK-HTML: class Rig.Check
CHECK-HTML: href="../_source_files/Rig.mo.html#REQ-1#4#4"
CHECK-HTML: component Rig.Check.req1Check
CHECK-HTML-NOT: function Rig.Check.req1Check()

RUN: %cat %T/html/%THIS_TEST_FOLDER/input_markdown.html | filecheck %s --check-prefix CHECK-MD
CHECK-MD: href="../_source_files/Rig.mo.html#REQ-2#5#5"
CHECK-MD: component Rig.Check.req2Check
