{#- Icons of the field widgets; field_widgets.js clones them. Insert menu
    items: the widget id. Field buttons: "edit" and the icon names of the
    widgets' extraAction(). -#}
<template id="template-field-widgets-icons">
  <span js-field_widgets-icon="edit">{%- include "icons/ico16_edit.svg" -%}</span>
  <span js-field_widgets-icon="format">{%- include "icons/ico16_wrench.svg" -%}</span>
  <span js-field_widgets-icon="table">{%- include "icons/ico16_table.svg" -%}</span>
  <span js-field_widgets-icon="link">{%- include "icons/ico16_link.svg" -%}</span>
  <span js-field_widgets-icon="anchor">{%- include "icons/ico16_anchor.svg" -%}</span>
</template>
