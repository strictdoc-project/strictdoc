{% extends "components/modal/index.jinja" %}

{% block modal__context %}project_settings{% endblock modal__context %}
{% block modal_header %}Project settings{% endblock modal_header %}
{% block modal_container %}
  <sdoc-modal-content
    data-js-project-settings-reload-blocking
    data-testid="project-settings-reloading"
  >
    <p data-js-project-settings-reload-message>
      Settings saved. Reloading the project...
    </p>
    <div
      class="project_settings_spinner"
      aria-label="Reloading"
      role="status"
      data-js-project-settings-reload-spinner
      data-testid="project-settings-reload-spinner"
    >
      <svg
        class="svg_icon project_settings_spinner_icon"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="8" cy="8" r="5.5" stroke-dasharray="22 13" />
      </svg>
    </div>
  </sdoc-modal-content>
{% endblock modal_container %}
