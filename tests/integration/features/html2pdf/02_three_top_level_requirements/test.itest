# @relation(SDOC-SRS-51, scope=file)

REQUIRES: TEST_HTML2PDF

RUN: %strictdoc export %S --formats=html2pdf --chromedriver="%chromedriver" --output-dir %T | filecheck %s --dump-input=fail
CHECK: html2pdf4doc: JS logs from the print session

RUN: %check_exists --file %T/html2pdf/pdf/input.sdoc.pdf
RUN: %check_exists --file %T/html2pdf/pdf/nested/input2.sdoc.pdf
RUN: %check_exists --file %T/html2pdf/pdf/nested/subnested/input3.sdoc.pdf

RUN: %check_exists --file %T/html2pdf/html/02_three_top_level_requirements/input.sdoc-PDF.html
RUN: %check_exists --file %T/html2pdf/html/02_three_top_level_requirements/nested/input2.sdoc-PDF.html
RUN: %check_exists --file %T/html2pdf/html/02_three_top_level_requirements/nested/subnested/input3.sdoc-PDF.html

RUN: python %S/test_pdf.py
