{% set template_type = 'Unresolved references' %}
{% extends "base.jinja.html" %}

{% block head_css %}
  {{ super() }}
  <link rel="stylesheet"
    href="{{ view_object.render_static_url('unresolved_references.css') }}"/>
{% endblock head_css %}

{% block title %}
  {{ view_object.project_config.project_title }} - {{ template_type }}
{% endblock title %}

{% block viewtype %}unresolved_references{% endblock viewtype %}

{% block layout_nav %}
  {% include "_shared/nav.jinja.html" %}
{% endblock layout_nav %}

{% block header_content %}
  {% with header__pagetype=template_type %}
    {% include "components/header/index.jinja" %}
  {% endwith %}
{% endblock header_content %}

{% block main_content %}
  {% include "features/unresolved_references/main.jinja" %}
{% endblock main_content %}
