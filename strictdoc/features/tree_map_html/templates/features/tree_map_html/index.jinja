{% set template_type = 'Tree map' %}

{% extends "base.jinja.html" %}

{% block head_css %}
  {{ super() }}
  <link rel="stylesheet" href="{{ view_object.render_static_url('tree_map_html.css') }}"/>
{% endblock head_css %}

{% block head_scripts %}
  {{ super() }}
  <script src="{{ view_object.render_static_url('tree_map_html.js') }}" defer></script>
{% endblock head_scripts %}

{% block title %}
  {{ view_object.project_config.project_title }} - {{ template_type }}
{% endblock title %}

{% block viewtype %}tree-map-html{% endblock viewtype %}

{% block layout_nav %}
  {% include "_shared/nav.jinja.html" %}
{% endblock layout_nav %}

{% block header_content %}
  {%- with header__pagetype=template_type -%}
    {% include "components/header/index.jinja" %}
  {%- endwith -%}
{% endblock header_content %}

{% block main_content %}
  <div class="main">
    <div
      class="tree-map-html"
      data-testid="tree-map-html-root"
      id="tree-map-html-root"
    ></div>
    <script id="tree-map-html-data" type="application/json">
      {{- view_object.tree_map_json -}}
    </script>
  </div>
{% endblock main_content %}
