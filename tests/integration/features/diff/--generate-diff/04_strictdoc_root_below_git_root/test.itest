#
# @relation(SDOC-SRS-111, scope=file)
#
# The StrictDoc project is in a subdirectory of the Git repository, and the
# command runs from that subdirectory.
# https://github.com/strictdoc-project/strictdoc/issues/2743
#

RUN: rm -rf %T/repo
RUN: mkdir -p %T/repo/requirements/project
RUN: cd %T/repo && git init
RUN: cd %T/repo && git config user.name "Your Name"
RUN: cd %T/repo && git config user.email "you@example.com"
RUN: cp %S/lhs/* %T/repo/requirements/project/
RUN: cd %T/repo && git add . && git commit -m "Test commit #1"
RUN: cp %S/rhs/* %T/repo/requirements/project/
RUN: cd %T/repo && git add . && git commit -m "Test commit #2"
RUN: cd %T/repo/requirements/project && %strictdoc export . --generate-diff-git "HEAD^..HEAD" --output-dir %T/output | filecheck %s --check-prefix=CHECK
CHECK: Export completed.

RUN: %cat %T/output/html/diff.html | filecheck %s --check-prefix=CHECK-HTML
CHECK-HTML: Hello world doc

RUN: cd %T/repo/requirements/project && %strictdoc export . --generate-diff-git "HEAD^..HEAD+" --output-dir %T/output_head_plus | filecheck %s --check-prefix=CHECK
