# @relation(SDOC-SRS-208, SDOC-SRS-139, scope=file)

RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/_source_files/file.adb.html"

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML
CHECK-HTML: <a{{.*}}href="../_source_files/file.adb.html#REQ-1#1#10">
CHECK-HTML: file.adb, <i>lines: 1-10</i>, entire file
CHECK-HTML: <a{{.*}}href="../_source_files/file.adb.html#REQ-2#1#10">
CHECK-HTML: file.adb, <i>lines: 1-10</i>, entire file

RUN: %cat %T/html/_source_files/file.adb.html | filecheck %s --dump-input=fail --check-prefix CHECK-FILE-ADB
CHECK-FILE-ADB: 1 - 10 | entire file

RUN: %cat %T/html/source_coverage.html | filecheck %s --dump-input=fail --check-prefix CHECK-SOURCE-COVERAGE
CHECK-SOURCE-COVERAGE: 100.0
