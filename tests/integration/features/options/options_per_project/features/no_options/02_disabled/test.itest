RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/02_disabled/input.sdoc-TABLE.html"
RUN: %check_exists --file "%T/html/02_disabled/input.sdoc-TRACE.html"
RUN: %check_exists --file "%T/html/02_disabled/input.sdoc-DEEP-TRACE.html"

RUN: %check_exists --file "%T/html/_static/mathjax/tex-mml-chtml.js"
RUN: %check_exists --file "%T/html/_static/mathjax/output/chtml/fonts/tex.js"
