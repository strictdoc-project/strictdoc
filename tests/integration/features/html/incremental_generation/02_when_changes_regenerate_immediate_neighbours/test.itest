RUN: %strictdoc --debug export %S --output-dir %T --no-parallelization | filecheck %s --dump-input=fail --check-prefix=CHECK-FIRST
CHECK-FIRST: Build search index
CHECK-FIRST: Export to HTML: Child doc
CHECK-FIRST: Export to HTML: Grandchild doc
CHECK-FIRST: Export to HTML: Parent doc

RUN: %strictdoc --debug export %S --output-dir %T --no-parallelization | filecheck %s --dump-input=fail --check-prefix=CHECK-SECOND
CHECK-SECOND: All documents are up-to-date. Skipping the generation of a search index.
CHECK-SECOND: Skip: Child doc
CHECK-SECOND: Skip: Grandchild doc
CHECK-SECOND: Skip: Parent doc

RUN: %touch %S/parent.sdoc
RUN: %strictdoc --debug export %S --output-dir %T --no-parallelization | filecheck %s --dump-input=fail --check-prefix=CHECK-THIRD
CHECK-THIRD: Build search index
CHECK-THIRD: Skip: Grandchild doc
CHECK-THIRD: Export to HTML: Child doc
CHECK-THIRD: Export to HTML: Parent doc

RUN: %touch %S/child.sdoc
RUN: %strictdoc --debug export %S --output-dir %T --no-parallelization | filecheck %s --dump-input=fail --check-prefix=CHECK-FOURTH
CHECK-FOURTH: Build search index
CHECK-FOURTH: Export to HTML: Child doc
CHECK-FOURTH: Export to HTML: Grandchild doc
CHECK-FOURTH: Export to HTML: Parent doc

RUN: %touch %S/grandchild.sdoc
RUN: %strictdoc --debug export %S --output-dir %T --no-parallelization | filecheck %s --dump-input=fail --check-prefix=CHECK-FIFTH
CHECK-FIFTH: Build search index
CHECK-FIFTH: Skip: Parent doc
CHECK-FIFTH: Export to HTML: Child doc
CHECK-FIFTH: Export to HTML: Grandchild doc
