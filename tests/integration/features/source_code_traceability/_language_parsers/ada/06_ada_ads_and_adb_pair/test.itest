# @relation(SDOC-SRS-208, SDOC-SRS-137, scope=file)

RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/_source_files/file.ads.html"
RUN: %check_exists --file "%T/html/_source_files/file.adb.html"

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML
CHECK-HTML: <a{{.*}}href="../_source_files/file.adb.html#REQ-1#4#8">
CHECK-HTML: file.adb, <i>lines: 4-8</i>, function Hello.Hello_World_1
CHECK-HTML: <a{{.*}}href="../_source_files/file.ads.html#REQ-1#2#5">
CHECK-HTML: file.ads, <i>lines: 2-5</i>, function Hello.Hello_World_1
CHECK-HTML: <a{{.*}}href="../_source_files/file.adb.html#REQ-2#10#11">
CHECK-HTML: file.adb, <i>lines: 10-11</i>, function Hello.Hello_World_2
CHECK-HTML: <a{{.*}}href="../_source_files/file.ads.html#REQ-2#7#10">
CHECK-HTML: file.ads, <i>lines: 7-10</i>, function Hello.Hello_World_2

RUN: %cat %T/html/_source_files/file.adb.html | filecheck %s --dump-input=fail --check-prefix CHECK-FILE-ADB
CHECK-FILE-ADB: 4 - 8 | function Hello.Hello_World_1()
CHECK-FILE-ADB: 10 - 11 | function Hello.Hello_World_2()

RUN: %cat %T/html/_source_files/file.ads.html | filecheck %s --dump-input=fail --check-prefix CHECK-FILE-ADS
CHECK-FILE-ADS: 2 - 5 | function Hello.Hello_World_1()
CHECK-FILE-ADS: 7 - 10 | function Hello.Hello_World_2()

RUN: %cat %T/html/source_coverage.html | filecheck %s --dump-input=fail --check-prefix CHECK-SOURCE-COVERAGE
CHECK-SOURCE-COVERAGE: 70.0
