# @relation(SDOC-SRS-213, scope=file)

#
# Verify that the format command aligns the misaligned Markdown pipe tables of
# a Markdown document, in the free text and in the node fields. A table in a
# fenced code block stays as it is. A second format pass must produce
# identical output (idempotency).
#

RUN: mkdir -p %T/pass1
RUN: cp %S/input.md %T/pass1/input.md
RUN: cp %S/strictdoc_config.py %T/pass1/strictdoc_config.py

RUN: %strictdoc format %T/pass1/
RUN: %diff %S/input_expected.md %T/pass1/input.md

RUN: cp -r %T/pass1 %T/pass2
RUN: %strictdoc format %T/pass2/
RUN: %diff %T/pass1/input.md %T/pass2/input.md
