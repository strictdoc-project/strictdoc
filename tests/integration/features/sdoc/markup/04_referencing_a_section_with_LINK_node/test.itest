RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %cat %T/html/04_referencing_a_section_with_LINK_node/input.sdoc.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML-DOC
CHECK-HTML-DOC: <a href="../04_referencing_a_section_with_LINK_node/nodes.sdoc.html#CUSTOM-1">{{.*}}Foo Bar</a></p>
CHECK-HTML-DOC: <a href="../04_referencing_a_section_with_LINK_node/nodes.sdoc.html#CUSTOM-2">{{.*}}CUSTOM-2</a></p>

RUN: %cat %T/html/04_referencing_a_section_with_LINK_node/input.sdoc-TABLE.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML-TABLE
CHECK-HTML-TABLE: <a href="../04_referencing_a_section_with_LINK_node/nodes.sdoc-TABLE.html#CUSTOM-1">{{.*}}Foo Bar</a></p>
CHECK-HTML-TABLE: <a href="../04_referencing_a_section_with_LINK_node/nodes.sdoc-TABLE.html#CUSTOM-2">{{.*}}CUSTOM-2</a></p>

RUN: %cat %T/html/04_referencing_a_section_with_LINK_node/input.sdoc-TRACE.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML-TRACE
CHECK-HTML-TRACE: <a href="../04_referencing_a_section_with_LINK_node/nodes.sdoc-TRACE.html#CUSTOM-1">{{.*}}Foo Bar</a></p>
CHECK-HTML-TRACE: <a href="../04_referencing_a_section_with_LINK_node/nodes.sdoc-TRACE.html#CUSTOM-2">{{.*}}CUSTOM-2</a></p>
