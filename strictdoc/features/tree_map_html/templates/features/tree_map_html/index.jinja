{% set template_type = 'Tree map' %}

{% extends "base.jinja.html" %}

{% block title %}
  {{ view_object.project_config.project_title }} - {{ template_type }}
{% endblock title %}

{% block viewtype %}tree-map-html{% endblock viewtype %}

{% block layout_nav %}
  {% include "_shared/nav.jinja.html" %}
{% endblock layout_nav %}

{% block header_content %}
  {%- with header__pagetype=template_type -%}
    {% include "components/header/index.jinja" %}
  {%- endwith -%}
{% endblock header_content %}

{% block main_content %}
  <div data-testid="tree-map-html-root"></div>
  <script id="tree-map-html-data" type="application/json">
    {{- view_object.tree_map_json -}}
  </script>
{% endblock main_content %}
