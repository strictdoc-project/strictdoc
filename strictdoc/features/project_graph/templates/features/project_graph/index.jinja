{% extends "base.jinja.html" %}
{% set template_type = "Project graph" %}

{% block head_scripts %}
  {{ super() }}
  <script src="{{ view_object.render_static_url('project_graph/3d-force-graph.min.js') }}"></script>
{% endblock head_scripts %}

{% block title %}
  {{ view_object.project_config.project_title }} - {{ template_type }}
{% endblock title %}

{% block viewtype %}project-graph{% endblock viewtype %}

{% block layout_nav %}
  {% include "_shared/nav.jinja.html" %}
{% endblock layout_nav %}

{% block toc_content %}
{% endblock toc_content %}

{% block header_content %}
  {%- with header__pagetype=template_type -%}
    {% include "components/header/index.jinja" %}
  {%- endwith -%}
{% endblock header_content %}

{% block main_content %}
  <div
    id="project_graph-view-switcher"
    style="position: absolute; z-index: 1; margin: 12px; font-family: sans-serif; font-size: 13px; color: #ccc;"
  >
    <label>
      View:
      <select id="project_graph-view-select" data-testid="project-graph-view-select">
        <option value="force">Force-directed</option>
        <option value="td" selected>Tree (top-down)</option>
        <option value="lr">Tree (left-right)</option>
        <option value="radialout">Radial</option>
        <option value="byDocument">By document (stacked planes)</option>
      </select>
    </label>
    <div style="margin-top: 6px;">
      <span style="color: #868e96;">&mdash;</span> containment
      &nbsp;
      <span style="color: #FF00FF; font-weight: bold;">&mdash;</span> relation
      &nbsp;
      <span style="color: #00FFFF; font-weight: bold;">&mdash;</span> file
    </div>
  </div>
  <div id="project_graph-container" style="width: 100%; height: calc(100vh - 60px);"></div>

  <script id="project_graph-data" type="application/json">{{ view_object.graph_data_json }}</script>
  <script>
    (function () {
      const graphData = JSON.parse(
        document.getElementById("project_graph-data").textContent
      );
      const nodeColors = {
        document: "#4C6EF5",
        section: "#82C91E",
        requirement: "#F76707",
        source_file: "#15AABF",
        test_file: "#0C8599",
      };
      const linkColors = {
        containment: "#868e96",
        relation: "#FF00FF",
        file: "#00FFFF",
      };

      // "By document" view: each document and its nodes are pinned to
      // their own horizontal plane (a fixed z), stacked one above another
      // (document 0 at z=0, document 1 at z=PLANE_SPACING, etc. — all
      // document-center nodes therefore share the same x/y and differ
      // only in z). The document node itself is pulled to the center of
      // its plane (x=0, y=0); every other node in that document keeps its
      // z pinned to the same plane but is left free on x/y, so the usual
      // charge/link forces settle it into a radial arrangement around the
      // document center.
      //
      // x is fixed via node.fx (works reliably). y is NOT fixed via
      // node.fy: dagMode "td"/"bu" own the y axis, and something in this
      // vendored 3d-force-graph build keeps clearing fy back to
      // `undefined` on every tick even after dagMode is set to null (fx
      // stays put, fy doesn't — confirmed via
      // `graph.graphData().nodes[i].fy` in the console). So y is instead
      // pulled toward 0 via a genuine custom d3Force nudging velocity
      // (vy), which doesn't touch fy and isn't affected by whatever keeps
      // resetting it.
      const PLANE_SPACING = 500;

      let byDocumentActive = false;

      function forceDocumentCenterYFactory() {
        let nodes = [];
        function force(alpha) {
          if (!byDocumentActive) return;
          nodes.forEach((node) => {
            if (node.type !== "document" || node.docIndex === undefined) {
              return;
            }
            node.vy = (node.vy || 0) + (0 - node.y) * alpha;
          });
        }
        force.initialize = (n) => {
          nodes = n;
        };
        return force;
      }

      function applyByDocumentLayout() {
        graph.graphData().nodes.forEach((node) => {
          if (node.docIndex === undefined) return;
          node.fz = node.docIndex * PLANE_SPACING;
          node.z = node.fz;
          if (node.type === "document") {
            node.fx = 0;
            node.x = 0;
          } else {
            delete node.fx;
          }
        });
        byDocumentActive = true;
      }

      function clearByDocumentLayout() {
        byDocumentActive = false;
        graph.graphData().nodes.forEach((node) => {
          delete node.fx;
          delete node.fz;
        });
      }

      // Dragging a node in 3d-force-graph pins fx/fy/fz to the drop point
      // and they stay pinned there — that's how a dragged-away document
      // ball ends up stuck off-center, and how a dragged child node could
      // end up on the wrong document's plane. Snap both back on drag end.
      function onNodeDragEnd(node) {
        if (!byDocumentActive || node.docIndex === undefined) return;
        node.fz = node.docIndex * PLANE_SPACING;
        node.z = node.fz;
        if (node.type === "document") {
          node.fx = 0;
          node.x = 0;
          node.y = 0;
        }
        graph.d3ReheatSimulation();
      }

      const graph = ForceGraph3D()(document.getElementById("project_graph-container"))
        .graphData(graphData)
        .nodeId("id")
        .nodeLabel("name")
        .nodeColor((node) => nodeColors[node.type] || "#AAAAAA")
        .nodeVal((node) => (node.type === "document" ? 6 : 2))
        .linkColor((link) => linkColors[link.kind] || "#868e96")
        .linkWidth((link) => (link.kind === "relation" ? 2 : 1))
        .linkDirectionalArrowLength(3)
        .dagMode("td")
        .d3Force("documentCenterY", forceDocumentCenterYFactory())
        .onNodeDragEnd(onNodeDragEnd);

      // Exposed for debugging via the browser console, e.g.:
      // graph.graphData().nodes.filter(n => n.type === "document")
      window.graph = graph;

      document
        .getElementById("project_graph-view-select")
        .addEventListener("change", (event) => {
          const mode = event.target.value;
          if (mode === "byDocument") {
            clearByDocumentLayout();
            graph.dagMode(null);
            applyByDocumentLayout();
          } else {
            clearByDocumentLayout();
            graph.dagMode(mode === "force" ? null : mode);
          }
          graph.d3ReheatSimulation();
        });
    })();
  </script>
{% endblock main_content %}
