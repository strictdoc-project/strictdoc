RUN: %strictdoc export %S --formats=html --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %cat %T/html/41_link_in_grid_table/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML-FILE
CHECK-HTML-FILE: <td><a href="#THING-1">🔗&nbsp;Thing</a></td>
CHECK-HTML-FILE: <td>A link with the anchor title.</td>
CHECK-HTML-FILE: <td><a href="#THING-1">Custom title</a></td>
CHECK-HTML-FILE: <td><a href="#THING-1">Quoted title</a></td>
CHECK-HTML-FILE: <td><a href="#THING-1">🔗&nbsp;Thing</a>s and
CHECK-HTML-FILE-NEXT: <a href="#THING-1">🔗&nbsp;Thing</a>_</td>
