REQUIRES: PLATFORM_IS_NOT_WINDOWS

RUN: cd "%strictdoc_root/" && %strictdoc --debug export "%strictdoc_root/" --output-dir="%T"

RUN: %check_exists --file "%T/html/index.html"
RUN: %check_exists --file %T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc.html
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-TABLE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-TRACE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-DEEP-TRACE.html"

RUN: %check_exists --file %T/html/strictdoc/docs/strictdoc_02_feature_map.sdoc.html
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_02_feature_map.sdoc-TABLE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_02_feature_map.sdoc-TRACE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_02_feature_map.sdoc-DEEP-TRACE.html"

RUN: %check_exists --file %T/html/strictdoc/docs/strictdoc_03_faq.sdoc.html
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_03_faq.sdoc-TABLE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_03_faq.sdoc-TRACE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_03_faq.sdoc-DEEP-TRACE.html"

RUN: %check_exists --file %T/html/strictdoc/docs/strictdoc_10_contributing.sdoc.html
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_10_contributing.sdoc-TABLE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_10_contributing.sdoc-TRACE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_10_contributing.sdoc-DEEP-TRACE.html"

RUN: %check_exists --file %T/html/strictdoc/docs/strictdoc_20_l1_system_requirements.sdoc.html
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_20_l1_system_requirements.sdoc-TABLE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_20_l1_system_requirements.sdoc-TRACE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_20_l1_system_requirements.sdoc-DEEP-TRACE.html"

RUN: %check_exists --file %T/html/strictdoc/docs/strictdoc_24_development_plan.sdoc.html
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_24_development_plan.sdoc-TABLE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_24_development_plan.sdoc-TRACE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_24_development_plan.sdoc-DEEP-TRACE.html"

RUN: %check_exists --file %T/html/strictdoc/docs/strictdoc_25_design.sdoc.html
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_25_design.sdoc-TABLE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_25_design.sdoc-TRACE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_25_design.sdoc-DEEP-TRACE.html"

# Naive way to check that the server-related links are not enabled in the static export.
RUN: %cat "%T/html/index.html" | filecheck %s --check-prefix=CHECK-TREE
CHECK-TREE-NOT: ReqIF

RUN: %cat "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc.html" | filecheck %s --check-prefix=CHECK-DOCUMENT
# When there is no positive check, filecheck will check all not-CHECKs.
CHECK-DOCUMENT-NOT: Export to ReqIF
CHECK-DOCUMENT-NOT: turbo.js

# Verify that the document does not have any Pygments lexing errors created from
# parsing the RST 'code' blocks.
CHECK-DOCUMENT-NOT: class="err"

RUN: %check_exists --file "%T/html/index.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-TABLE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-TRACE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-DEEP-TRACE.html"

TODO: etree.parse fails on the "&nbsp;" surprisingly. Fix it later :(
RUN: sed -i.bak 's/\&nbsp;/ /g' "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc.html"
RUN: sed -i.bak 's/\&nbsp;/ /g' "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-TABLE.html"
RUN: sed -i.bak 's/\&nbsp;/ /g' "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-TRACE.html"
RUN: sed -i.bak 's/\&nbsp;/ /g' "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-DEEP-TRACE.html"

RUN: %html_markup_validator "%T/html/index.html"
RUN: %html_markup_validator "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc.html"
RUN: %html_markup_validator "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-TABLE.html"
RUN: %html_markup_validator "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-TRACE.html"
RUN: %html_markup_validator "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-DEEP-TRACE.html"

TODO: etree.parse fails on the "&nbsp;" surprisingly. Fix it later :(
RUN: sed -i.bak 's/\&nbsp;/ /g' "%T/html/strictdoc/docs/strictdoc_20_l1_system_requirements.sdoc.html"
RUN: sed -i.bak 's/\&nbsp;/ /g' "%T/html/strictdoc/docs/strictdoc_20_l1_system_requirements.sdoc-TABLE.html"
RUN: sed -i.bak 's/\&nbsp;/ /g' "%T/html/strictdoc/docs/strictdoc_20_l1_system_requirements.sdoc-TRACE.html"
RUN: sed -i.bak 's/\&nbsp;/ /g' "%T/html/strictdoc/docs/strictdoc_20_l1_system_requirements.sdoc-DEEP-TRACE.html"

RUN: %html_markup_validator "%T/html/index.html"
RUN: %html_markup_validator "%T/html/strictdoc/docs/strictdoc_20_l1_system_requirements.sdoc.html"
RUN: %html_markup_validator "%T/html/strictdoc/docs/strictdoc_20_l1_system_requirements.sdoc-TABLE.html"
RUN: %html_markup_validator "%T/html/strictdoc/docs/strictdoc_20_l1_system_requirements.sdoc-TRACE.html"
RUN: %html_markup_validator "%T/html/strictdoc/docs/strictdoc_20_l1_system_requirements.sdoc-DEEP-TRACE.html"

RUN: %check_exists --file %T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc.html
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-TABLE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-TRACE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_01_user_guide.sdoc-DEEP-TRACE.html"

RUN: %check_exists --file %T/html/strictdoc/docs/strictdoc_21_l2_high_level_requirements.sdoc.html
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_21_l2_high_level_requirements.sdoc-TABLE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_21_l2_high_level_requirements.sdoc-TRACE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_21_l2_high_level_requirements.sdoc-DEEP-TRACE.html"

RUN: %check_exists --file %T/html/strictdoc/docs/strictdoc_24_development_plan.sdoc.html
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_24_development_plan.sdoc-TABLE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_24_development_plan.sdoc-TRACE.html"
RUN: %check_exists --file "%T/html/strictdoc/docs/strictdoc_24_development_plan.sdoc-DEEP-TRACE.html"

RUN: %check_exists --file "%T/html/_source_files/strictdoc/core/tree_cycle_detector.py.html"
RUN: %check_exists --file "%T/html/_source_files/strictdoc/core/traceability_index_builder.py.html"

RUN: %cat %T/html/strictdoc/docs/strictdoc_21_l2_high_level_requirements.sdoc.html | filecheck %s --check-prefix CHECK-3-REQUIREMENTS
CHECK-3-REQUIREMENTS: href="../../_source_files/strictdoc/core/traceability_index_builder.py.html#SDOC-SRS-30#{{.*}}#{{.*}}"
CHECK-3-REQUIREMENTS: href="../../_source_files/strictdoc/core/tree_cycle_detector.py.html#SDOC-SRS-30#{{.*}}#{{.*}}"

RUN: %cat "%T/html/_source_files/strictdoc/core/tree_cycle_detector.py.html" | filecheck %s --check-prefix CHECK-TREE-CYCLE-DETECTOR
CHECK-TREE-CYCLE-DETECTOR: href="../../../strictdoc/docs/strictdoc_21_l2_high_level_requirements.sdoc.html#SDOC-SRS-30"
CHECK-TREE-CYCLE-DETECTOR: href="../../../_source_files/strictdoc/core/traceability_index_builder.py.html#SDOC-SRS-30
