#
# Verify that [ANCHOR: uid] and [ANCHOR: uid, title] in Markdown section bodies
# are rendered as named anchors in the exported HTML output, and that [LINK: uid]
# pointing to them produces hyperlinks.
#

RUN: %strictdoc export %S --formats=html --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML

CHECK-HTML: id="SEC-INTRO"
CHECK-HTML: id="SEC-DETAILS"
CHECK-HTML: href="#SEC-INTRO"

# An anchor with incoming links renders the list of the links as HTML, not
# as escaped HTML code, and the text after the anchor stays a paragraph.
RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-BACK-LINKS
CHECK-BACK-LINKS: <div class="anchor_back_links">
CHECK-BACK-LINKS: <p>This section describes the introduction.</p>

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-NO-ESCAPED-HTML
CHECK-NO-ESCAPED-HTML-NOT: &lt;div class=&quot;anchor_back_links
