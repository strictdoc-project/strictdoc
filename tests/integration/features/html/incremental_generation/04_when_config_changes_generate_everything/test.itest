#
# @relation(SDOC-SRS-2, scope=file)
#

RUN: %strictdoc --debug export %S --no-parallelization --config %S/strictdoc_config.py --output-dir %T | filecheck %s --dump-input=fail --check-prefix=CHECK-FIRST
CHECK-FIRST: Export to HTML: Parent doc
CHECK-FIRST: Export to HTML: Child doc
CHECK-FIRST: Export to HTML: Grandchild doc

RUN: %strictdoc --debug export %S --no-parallelization --config %S/strictdoc_config.py --output-dir %T | filecheck %s --dump-input=fail --check-prefix=CHECK-SECOND
RUN: %strictdoc --debug export %S --no-parallelization --config %S/strictdoc_config.py --output-dir %T | filecheck %s --dump-input=fail --check-prefix=CHECK-SECOND
CHECK-SECOND: Skip: Parent doc
CHECK-SECOND: Skip: Child doc
CHECK-SECOND: Skip: Grandchild doc

RUN: %touch %S/strictdoc_config.py
RUN: %strictdoc --debug export %S --no-parallelization --config %S/strictdoc_config.py --output-dir %T | filecheck %s --dump-input=fail --check-prefix=CHECK-THIRD
CHECK-THIRD: Export to HTML: Parent doc
CHECK-THIRD: Export to HTML: Child doc
CHECK-THIRD: Export to HTML: Grandchild doc
