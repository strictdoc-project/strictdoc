# @relation(SDOC-SRS-208, SDOC-SRS-137, scope=file)

RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/_source_files/file.adb.html"

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML
CHECK-HTML: <a{{.*}}href="../_source_files/file.adb.html#REQ-1#4#10">
CHECK-HTML: file.adb, <i>lines: 4-10</i>, function Hello.Hello_World
CHECK-HTML: <a{{.*}}href="../_source_files/file.adb.html#REQ-1#20#26">
CHECK-HTML: file.adb, <i>lines: 20-26</i>, function Hello.Hello_World_3
CHECK-HTML: <a{{.*}}href="../_source_files/file.adb.html#REQ-1#28#35">
CHECK-HTML: file.adb, <i>lines: 28-35</i>, function Hello.Hello_World_4

RUN: %cat %T/html/_source_files/file.adb.html | filecheck %s --dump-input=fail --check-prefix CHECK-FILE-ADB
CHECK-FILE-ADB: 4 - 10 | function Hello.Hello_World()
CHECK-FILE-ADB: 12 - 18 | function Hello.Hello_World_2()
CHECK-FILE-ADB: 20 - 26 | function Hello.Hello_World_3()
CHECK-FILE-ADB: 28 - 35 | function Hello.Hello_World_4()

RUN: %cat %T/html/source_coverage.html | filecheck %s --dump-input=fail --check-prefix CHECK-SOURCE-COVERAGE
CHECK-SOURCE-COVERAGE: 90.6
