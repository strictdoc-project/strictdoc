{% extends "base.jinja.html" %}

{% block head_css %}
  {{ super() }}
  <link rel="stylesheet" href="{{ view_object.render_static_url('html2pdf4doc.css') }}"/>
{% endblock head_css %}

{% block head_scripts %}
  {# Load StrictDoc core before local feature scripts. #}
  <script src="{{ view_object.render_static_url('app_core.js') }}"></script>
  <script src="{{ view_object.render_static_url('dropdown_menu.js') }}"></script>
  <script src="{{ view_object.render_static_url('resizable_bar.js') }}"></script>
  <script src="{{ view_object.render_static_url('project_tree_preserve_scroll.js') }}"></script>
  <script src="{{ view_object.render_static_url('toc_highlighting.js') }}"></script>

  {%- if view_object.project_config.is_activated_mathjax() -%}
  <script id="MathJax-script" async src="{{ view_object.render_static_url('mathjax/tex-mml-chtml.js') }}"></script>
  {%- endif -%}
  {%- if view_object.project_config.is_activated_mermaid() -%}
    <script src="{{ view_object.render_static_url('mermaid/mermaid.min.js') }}"></script>
    <script>
      mermaid.initialize({ startOnLoad: false });
    </script>
  {%- endif -%}
  {%- if view_object.project_config.is_activated_plantuml() -%}
    <script src="{{ view_object.render_static_url('plantuml/viz-global.js') }}"></script>
    <script src="{{ view_object.render_static_url('plantuml/plantuml-core.js') }}"></script>
    <script src="{{ view_object.render_static_url('plantuml/plantuml.js') }}"></script>
  {%- endif -%}
  {%- if view_object.project_config.is_activated_html2pdf() -%}
  <script
    data-init="manual"
    src="{{ view_object.render_static_url('html2pdf4doc.min.js') }}"
  ></script>
  <script>
    {#-
      html2pdf4doc's own render() sequence is: await DOMContentLoaded,
      show the preloader, await window "load", then (via renderReady
      below) wait for Mermaid/PlantUML before it measures/paginates the
      page. renderReady runs after "load", by which point the document
      body (and its "pre.mermaid"/"pre.plantuml" blocks) already exists,
      so it is safe to kick the diagram renderers off right here.
    -#}
    HTML2PDF4DOC.init({
      preloader: true,
      preloaderTarget: "[html2pdf-preloader]",
      preloaderBackground: "#F2F5F9",
      forcedPageBreakSelectors: "",
      pageBreakAfterSelectors: ".pdf-toc .free_text",
      pageBreakBeforeSelectors: "H2 .sdoc-html2pdf4doc-break-before",
      noBreakSelectors: ".html2pdf4doc-no-break sdoc-section-title sdoc-meta sdoc-node-title .pdf-toc-row",
      noHangingSelectors: ".html2pdf4doc-no-hanging sdoc-section-title sdoc-anchor sdoc-meta .admonition-title sdoc-node-title sdoc-node-field-label strong:only-child",
      renderReady: function () {
        var diagramRenderers = [];
        {%- if view_object.project_config.is_activated_mermaid() %}
        diagramRenderers.push(mermaid.run());
        {%- endif %}
        {%- if view_object.project_config.is_activated_plantuml() %}
        diagramRenderers.push(window.strictdocRenderPlantUML());
        {%- endif %}
        return Promise.all(diagramRenderers);
      },
    });
  </script>
  {%- endif -%}

  {{ super() }}
{% endblock head_scripts %}
{% block title %}{{ view_object.document.title }} - {{ view_object.get_page_title() }}{% endblock title %}
{% block viewtype %}{{ "html2pdf" }}{% endblock viewtype %}

{% block layout_nav %}
  {% include "_shared/nav.jinja.html" %}
{% endblock layout_nav %}

{% block tree_content %}
  {% include "screens/document/_shared/resizable_bar_with_project_tree.jinja" %}
{% endblock tree_content %}

{% block toc_content %}
  {% include "screens/document/_shared/resizable_bar_with_toc.jinja" %}
{% endblock toc_content %}

{%- set header_items = [
      "screens/document/_shared/frame_header_document_title.jinja",
      "screens/document/_shared/frame_viewtype_menu.jinja"
    ]
-%}

{% block header_content %}
  {%- with
      header__items=header_items
  -%}
    {% include "components/header/index.jinja" %}
  {%- endwith -%}
{% endblock header_content %}

{% block main_content %}
  {% include "features/html2pdf/main.jinja" %}
{% endblock main_content %}
