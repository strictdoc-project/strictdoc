# @relation(SDOC-LLR-219, SDOC-LLR-220, scope=file)

RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/_source_files/Check.mo.html"

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --check-prefix CHECK-HTML
CHECK-HTML: <a{{.*}}href="../_source_files/Check.mo.html#TC-1#2#13">
CHECK-HTML: <a{{.*}}href="../_source_files/Check.mo.html#REQ-1#5#6">
CHECK-HTML: <a{{.*}}href="../_source_files/Check.mo.html#REQ-2#7#7">
CHECK-HTML: <a{{.*}}href="../_source_files/Check.mo.html#REQ-3#7#7">

RUN: %cat %T/html/_source_files/Check.mo.html | filecheck %s --check-prefix CHECK-SOURCE-FILE
CHECK-SOURCE-FILE: href="../_source_files/Check.mo.html#REQ-1#5#6"
CHECK-SOURCE-FILE: <b>[ 5-6 ]</b>
CHECK-SOURCE-FILE: Check.mo, component Rig.Check.req1Check
CHECK-SOURCE-FILE: href="../_source_files/Check.mo.html#REQ-2#7#7"
CHECK-SOURCE-FILE: <b>[ 7-7 ]</b>
CHECK-SOURCE-FILE: Check.mo, component Rig.Check.req3Check
CHECK-SOURCE-FILE: href="../_source_files/Check.mo.html#REQ-3#7#7"
CHECK-SOURCE-FILE: Check.mo, component Rig.Check.req3Check
CHECK-SOURCE-FILE: href="../_source_files/Check.mo.html#TC-1#2#13"
CHECK-SOURCE-FILE: <b>[ 2-13 ]</b>
CHECK-SOURCE-FILE: Check.mo, class Rig.Check
